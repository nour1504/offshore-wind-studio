&share
 wrf_core             = 'ARW',
 max_dom              = 2,
 start_date           = '2025-10-01_00:00:00', '2025-10-01_00:00:00',
 end_date             = '2025-10-02_00:00:00', '2025-10-02_00:00:00',
 interval_seconds     = 21600,
 opt_output_from_geogrid_path = './',
/

&geogrid
 parent_id            = 1, 1,
 parent_grid_ratio    = 1, 3,
 i_parent_start       = 1, 34,
 j_parent_start       = 1, 34,
 e_we                 = 100, 100,
 e_sn                 = 100, 100,
 geog_data_res        = 'default', 'default',
 dx                   = 9000,
 dy                   = 9000,
 map_proj             = 'lambert',
 ref_lat              = 55.5,
 ref_lon              = 7.8,
 truelat1             = 54.0,
 truelat2             = 57.0,
 stand_lon            = 7.8,
 geog_data_path       = '/geog/WPS_GEOG/',
 opt_geogrid_tbl_path = '/opt/wrf/WPS/geogrid/',
/

&ungrib
 out_format           = 'WPS',
 prefix               = 'FILE',
/

&metgrid
 fg_name              = 'FILE',
 opt_metgrid_tbl_path = '/opt/wrf/WPS/metgrid/',
/
